{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https",
    "build": "next build && node tools/flatten-segments.mjs && node tools/csp-hashes.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\" \"tools/**/*.test.mjs\"",
    "generate:api": "orval",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.6",
    "@microsoft/signalr": "11.0.0",
    "@stripe/react-stripe-js": "7.1.0",
    "@stripe/stripe-js": "10.3.0",
    "@tanstack/react-query": "5.107.1",
    "i18next": "27.1.2",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.1",
    "react-zoom-pan-pinch": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "orval": "8.48.0",
    "prettier": "3.10.1",
    "typescript": "^5"
  }
}
