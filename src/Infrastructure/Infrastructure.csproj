<Project Sdk="Microsoft.NET.Sdk">
  <!-- EF Core, outbox/inbox, workers, Stripe, mock POS, message senders. -->
  <PropertyGroup>
    <AssemblyName>Reservation.Infrastructure</AssemblyName>
    <RootNamespace>Reservation.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- BackgroundService, options and logging for the workers; the shared framework, not a NuGet package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Direct so Dependabot sees them (transitive pins alone are not updated); versions stay central. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Deposits, refunds and webhook signatures (Design §8); only behind IPaymentProvider and StripeWebhookVerifier. -->
    <PackageReference Include="Stripe.net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>
</Project>
