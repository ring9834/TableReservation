{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Demo": {
    "Enabled": true,
    "ResetIfStale": true,
    "Clock": {
      "Mode": "Fixed",
      "FixedLocalTime": "18:25"
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000"]
  }
}
