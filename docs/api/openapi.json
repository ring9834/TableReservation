  "components": {
    "schemas": {
      "ApiProblem": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId",
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "AvailabilityResponse": {
        "required": [
          "date",
          "partySize",
          "requestedTime",
          "requestedTimeAvailable",
          "timeZone",
          "slots"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "partySize": {
            "type": "integer",
            "format": "int32"
          },
          "requestedTime": {
            "type": [
              "null",
              "string"
            ],
            "format": "time"
          },
          "requestedTimeAvailable": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "timeZone": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableSlot"
            }
          }
        }
      },
      "AvailableSlot": {
        "required": [
          "startsAt",
          "localTime"
        ],
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "localTime": {
            "type": "string",
            "format": "time"
          }
        }
      },
      "BookingChannel": {
        "enum": [
          "online",
          "phone",
          "walkIn"
        ]
      },
      "BookingListItem": {
        "required": [
          "id",
          "reference",
          "status",
          "channel",
          "partySize",
          "startsAt",
          "endsAt",
          "tables",
          "guestName",
          "mobileMasked",
          "hasAllergy",
          "allergyNotes",
          "occasion",
          "notes",
          "deposit",
          "depositStatus",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "channel": {
            "$ref": "#/components/schemas/BookingChannel"
          },
          "partySize": {
            "type": "integer",
            "format": "int32"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "tables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TableRef"
            }
          },
          "guestName": {
            "type": [
              "null",
              "string"
            ]
          },
          "mobileMasked": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasAllergy": {
            "type": "boolean"
          },
          "allergyNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "occasion": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "deposit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ]
          },
          "depositStatus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DepositStatus"
              }
            ]
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "BookingListResponse": {
        "required": [
          "day",
          "timeZone",
          "items"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "timeZone": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingListItem"
            }
          }
        }
      },
      "BookingStateResponse": {
        "required": [
          "bookingId",
          "status",
          "version",
          "refundDecision"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          },
          "refundDecision": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RefundDecision"
              }
            ]
          }
        }
      },
      "BookingStatus": {
        "enum": [
          "pendingPayment",
          "booked",
          "confirmed",
          "seated",
          "completed",
          "cancelled"
        ]
      },
      "BookingVersionRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "CreateBookingRequest": {
        "required": [
          "startsAt",
          "partySize",
          "name",
          "mobile",
          "language"
        ],
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "partySize": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "mobile": {
            "minLength": 1,
            "type": "string"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "email": {
            "maxLength": 254,
            "type": [
              "null",
              "string"
            ],
            "format": "email"
          },
          "allergyNotes": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          },
          "occasion": {
            "maxLength": 50,
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "maxLength": 500,
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateBookingResponse": {
        "required": [
          "bookingId",
          "reference",
          "status",
          "version",
          "startsAt",
          "endsAt",
          "partySize",
          "tableIds",
          "deposit",
          "holdExpiresAt",
          "clientSecret"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
